<robot name="rexrov" xmlns:xacro="http://www.ros.org/wiki/xacro" >
  <xacro:arg name="debug" default="0"/>
  <xacro:arg name="namespace" default="rexrov"/>
  <xacro:arg name="inertial_reference_frame" default="world"/>
  <!-- Include the ROV macro file -->
  <xacro:include filename="$(find uuv_descriptions)/urdf/rexrov_base.xacro"/>
  <xacro:include filename="$(find uuv_descriptions)/urdf/rexrov.gazebo.xacro"/>
  <!-- Include NPS multibeam sonar -->
  <xacro:include filename="$(find nps_uw_multibeam_sonar)/urdf/multibeam_sonar_blueview_p900.xacro"/>

  <!-- NPS multibeam sonar args -->
  <xacro:arg name="sonar_name" default="blueview_p900"/>
  <xacro:arg name="sonar_image_topic" default="sonar_image"/>
  <xacro:arg name="sonar_image_raw_topic" default="sonar_image_raw"/>
  <xacro:arg name="gpu_ray" default="true"/>
  <xacro:arg name="maxDistance" default="15"/>
  <xacro:arg name="raySkips" default="10"/>
  <xacro:arg name="plotScaler" default="1"/>
  <xacro:arg name="sensorGain" default="0.04"/>
  <xacro:arg name="writeLog" default="false"/>
  <xacro:arg name="writeFrameInterval" default="5"/>
  <xacro:arg name="gaussian_noise_mean" default="0.0"/>
  <xacro:arg name="gaussian_noise_stddev" default="0.0"/>
  <xacro:arg name="fidelity" default="500"/>
  <xacro:arg name="artificialVehicleVibration" default="false"/>
  <xacro:arg name="constantReflectivity" default="true"/>
  <xacro:arg name="reflectivityDatabaseFile" default="variationalReflectivityDatabase.csv"/>
  <xacro:arg name="ray_visual" default="false"/>
  <xacro:arg name="scale" default="1 1 1"/>

  <!-- Create the rexrov -->
  <xacro:rexrov_base
    namespace="$(arg namespace)"
    inertial_reference_frame="$(arg inertial_reference_frame)">
    <!-- The underwater object plugin is given as an input block parameter to
     allow the addition of external models of manipulator units -->
    <gazebo>
      <plugin name="uuv_plugin" filename="libuuv_underwater_object_ros_plugin.so">
        <fluid_density>1028.0</fluid_density>
        <flow_velocity_topic>hydrodynamics/current_velocity</flow_velocity_topic>
        <debug>$(arg debug)</debug>
        <!-- Adding the hydrodynamic and hydrostatic parameters for the vehicle-->
        <xacro:rexrov_hydro_model namespace="$(arg namespace)"/>
      </plugin>
    </gazebo>
  </xacro:rexrov_base>

  <!-- Attach NPS multibeam sonar to rexrov -->
  <xacro:multibeam_blueview_p900_macro
    name="$(arg sonar_name)"
    scale="$(arg scale)"
    sonar_image_topic="$(arg sonar_image_topic)"
    sonar_image_raw_topic="$(arg sonar_image_raw_topic)"
    debug="$(arg debug)"
    gpu_ray="$(arg gpu_ray)"
    robot_name="$(arg namespace)"
    maxDistance="$(arg maxDistance)"
    raySkips="$(arg raySkips)"
    plotScaler="$(arg plotScaler)"
    sensorGain="$(arg sensorGain)"
    writeLog="$(arg writeLog)"
    writeFrameInterval="$(arg writeFrameInterval)"
    gaussian_noise_mean="$(arg gaussian_noise_mean)"
    gaussian_noise_stddev="$(arg gaussian_noise_stddev)"
    fidelity="$(arg fidelity)"
    artificialVehicleVibration="$(arg artificialVehicleVibration)"
    constantReflectivity="$(arg constantReflectivity)"
    reflectivityDatabaseFile="$(arg reflectivityDatabaseFile)"
    robot_link="$(arg namespace)/base_link"
    ray_visual="$(arg ray_visual)">
    <origin xyz="1.4 0 0.65" rpy="0 0 0"/>
  </xacro:multibeam_blueview_p900_macro>

  <!-- Joint state publisher plugin -->
  <xacro:default_joint_state_publisher namespace="$(arg namespace)" update_rate="50"/>

</robot>
